# ==============================================================================
# PICC-PC-Haproxy-Spoa - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific values.
# Do NOT commit '.env' or real credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Network Configuration
# ------------------------------------------------------------------------------
# TCP port on which the HAProxy SPOE (Stream Processing Offload Engine) agent listens
# HAProxy connects to this port using the binary SPOE protocol (Default: :9000)
SPOA_PORT=:9000

# HTTP port on which Kubernetes liveness/readiness/startup probes listen
# Serves /healthz, /readyz, and /livez endpoints (Default: :8080)
HEALTH_PORT=:8080

# ------------------------------------------------------------------------------
# 2. Upstream Authorization Service Integration
# ------------------------------------------------------------------------------
# REST API URL for the upstream service that evaluates user and environment permissions
# Payload: {"userId": "...", "envCode": "...", "url": "..."}
# Expected Response: {"allowed": true|false}
AUTH_SERVICE_URL=http://localhost:8080/api/v1/auth/access

# Upstream HTTP request timeout in seconds (Default: 5)
AUTH_TIMEOUT_SECONDS=5

# ------------------------------------------------------------------------------
# 3. Access Control & Authorization Bypass Rules
# ------------------------------------------------------------------------------
# Comma-separated list of hostnames allowed to bypass authorization checks
# Useful for identity providers, public portals, login endpoints, and static resources
# Example: auth.example.com,login.example.com,portal.example.com
BYPASS_HOSTS=

# Comma-separated list of environment identifiers allowed to bypass authorization checks
# Example: MASTER,SUPERADMIN
BYPASS_ENV_IDS=MASTER

# ------------------------------------------------------------------------------
# 4. Logging & Diagnostics
# ------------------------------------------------------------------------------
# Log level for agent operations: DEBUG, INFO, WARN, ERROR (Default: INFO)
LOG_LEVEL=INFO
